<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimePackageRid Condition="'$(RuntimePackageRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimePackageRid>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/JKToolKit.CodexSDK/JKToolKit.CodexSDK.csproj" />
    <PackageReference Include="JKToolKit.CodexSDK.Runtime.$(RuntimePackageRid)" Version="$(CodexCliVersion)" Condition="'$(UsePinnedRuntime)' == 'true'" />
  </ItemGroup>
</Project>
