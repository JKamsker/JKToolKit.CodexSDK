{
  "stryker-config": {
    "project": "JKToolKit.CodexSDK.AgentFramework.csproj",
    "configuration": "Release",
    "mutate": [
      "**/*.cs"
    ],
    "mutation-level": "Complete",
    "concurrency": 4,
    "coverage-analysis": "perTest",
    "additional-timeout": 3000,
    "reporters": [
      "json",
      "cleartext",
      "dots"
    ],
    "thresholds": {
      "high": 95,
      "low": 80,
      "break": 0
    },
    "break-on-initial-test-failure": true
  }
}
