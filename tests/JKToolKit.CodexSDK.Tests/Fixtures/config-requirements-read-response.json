{
  "requirements": {
    "allowedApprovalPolicies": ["never", "on-request"],
    "allowedApprovalsReviewers": ["user", "auto_review"],
    "allowedSandboxModes": ["read-only", "workspace-write"],
    "allowedWindowsSandboxImplementations": ["elevated", "unelevated"],
    "allowedPermissionProfiles": {
      ":read-only": true,
      "managed": false
    },
    "defaultPermissions": ":read-only",
    "allowedWebSearchModes": ["disabled", "cached", "live"],
    "featureRequirements": {
      "apps": true,
      "network": false,
      "ignoreMe": "not-a-bool"
    },
    "additionalDeveloperInstructions": "Follow managed policy.",
    "allowManagedHooksOnly": true,
    "allowBrowserAndComputerUse": true,
    "allowAppshots": false,
    "allowRemoteControl": false,
    "allowLoginShell": true,
    "cliAuthCredentialsStore": "ephemeral",
    "chatgptBaseUrl": "https://managed.example/backend-api/",
    "checkForUpdateOnStartup": false,
    "windowsSandboxPrivateDesktop": true,
    "sqliteHome": "file:///home/user/.codex-state",
    "logDir": "file:///home/user/.codex/log",
    "modelCatalogJson": "file:///home/user/.codex/models.json",
    "computerUse": {
      "allowLockedComputerUse": true,
      "allowPersistentApproval": false,
      "defaultAppAccess": "deny",
      "macos": {
        "bundleIds": {
          "com.apple.Terminal": "allow",
          "com.example.Blocked": "deny"
        }
      },
      "windows": {
        "aumids": {
          "Microsoft.WindowsTerminal_8wekyb3d8bbwe!App": "allow"
        },
        "exes": [
          {
            "publisherName": "Microsoft Corporation",
            "productName": "Windows Terminal",
            "binaryName": "wt.exe",
            "access": "allow"
          }
        ]
      }
    },
    "browserUse": {
      "allowHistoryAccess": true,
      "disableAutoReview": true,
      "allowGlobalPersistentApproval": false,
      "defaultOriginPolicy": {
        "access": "allow",
        "downloads": "deny",
        "uploads": "deny",
        "fullCdpAccess": "deny",
        "autoReview": "allow",
        "persistentApproval": true,
        "accessApprovalLifetime": "thread"
      },
      "origins": {
        "https://example.com": {
          "access": "allow",
          "downloads": "allow",
          "uploads": "deny",
          "fullCdpAccess": "deny",
          "autoReview": "allow",
          "persistentApproval": false,
          "accessApprovalLifetime": "turn"
        }
      }
    },
    "inAppBrowser": {
      "allowExternalBrowserSettingsImport": true
    },
    "feedback": {
      "enabled": false
    },
    "autoReview": {
      "requiredOnModels": ["o4-mini"],
      "ignoreRules": ["trusted-workspace"]
    },
    "hooks": {
      "managedDir": ".codex/hooks"
    },
    "enforceResidency": "us",
    "network": {
      "enabled": true,
      "httpPort": 8080,
      "socksPort": 1080,
      "allowUpstreamProxy": false,
      "dangerouslyAllowNonLoopbackProxy": false,
      "dangerouslyAllowNonLoopbackAdmin": false,
      "allowedDomains": ["example.com"],
      "deniedDomains": ["bad.example"],
      "allowUnixSockets": ["/var/run/docker.sock"],
      "unixSockets": {
        "/tmp/codex.sock": "allow",
        "/tmp/blocked.sock": "deny"
      },
      "allowLocalBinding": true,
      "unknownField": "preserve"
    },
    "unknownTopLevelField": true
  }
}
