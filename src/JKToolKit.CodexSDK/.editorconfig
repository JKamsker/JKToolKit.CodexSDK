# Handwritten consumer facade is versioned separately from generated protocol DTOs.
[*.cs]
dotnet_diagnostic.RS0016.severity = none
# Existing overload conventions use an optional CancellationToken throughout.
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none
dotnet_diagnostic.RS0017.severity = error

[{Facade,Diagnostics}/**.cs]
dotnet_diagnostic.RS0016.severity = error

[AppServer/{CodexTurnHandle,CodexTurnResult,CodexTurnUsage,CodexTurnSubscription}.cs]
dotnet_diagnostic.RS0016.severity = error
